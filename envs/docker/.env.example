# Copy to envs/docker/.env (gitignored) and customize for the target host.

# ---- Host User Mapping ----
# On Linux cloud boxes running as root (e.g. AutoDL / Vast.ai), set DEV_UID=0 and DEV_GID=0.
# On normal Linux workstations or macOS, match `id -u` and `id -g` (typically 1000).
DEV_USERNAME=dev
DEV_UID=1000
DEV_GID=1000

# ---- Build & Network Mirrors (optional) ----
# Example for China mainland hosts (host only defaults to http:// to avoid missing CA certs in minimal images):
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# HF_ENDPOINT=https://hf-mirror.com
APT_MIRROR=
UV_INDEX_URL=
HF_ENDPOINT=
HF_TOKEN=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
INSTALL_GH_CLI=true
INSTALL_CPP_EXTRA=true
MAX_JOBS=4
SHM_SIZE=16gb

# ---- CPU Profile ----
CPU_BASE_IMAGE=ubuntu:24.04

# ---- NVIDIA CUDA Profile ----
# Switch to nvidia/cuda:12.6.3-devel-ubuntu24.04 if host driver does not yet support CUDA 12.8
NVIDIA_BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu24.04
NVIDIA_VISIBLE_DEVICES=all
PYTORCH_CUDA_TAG=cu128
# Optional compile target override, e.g. "8.9;9.0" for RTX 4090 / H100
TORCH_CUDA_ARCH_LIST=

# ---- AMD ROCm Profile ----
# Match your host ROCm/KFD driver version:
#   rocm/dev-ubuntu-24.04:7.1.1-complete
#   rocm/dev-ubuntu-24.04:6.4.4-complete
#   rocm/pytorch:latest
ROCM_BASE_IMAGE=rocm/dev-ubuntu-24.04:7.1.1-complete
# On Linux host, inspect with: getent group render | cut -d: -f3
RENDER_GID=render
HIP_VISIBLE_DEVICES=0
PYTORCH_ROCM_TAG=rocm6.4
# Examples: MI300X -> gfx942, MI355X -> gfx950, RX 7900 XTX -> gfx1100
PYTORCH_ROCM_ARCH=
MORI_GPU_ARCHS=
HSA_OVERRIDE_GFX_VERSION=

# ---- Other Accelerators Profile ----
# Replace with vendor official Ubuntu/Debian base image (Intel XPU, QAIC, Ascend CANN, etc.)
OTHER_BASE_IMAGE=ubuntu:24.04
OTHER_INSTALL_CPP_EXTRA=false
OTHER_SKIP_TORCH=1
