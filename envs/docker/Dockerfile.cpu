# syntax=docker/dockerfile:1.7
# Pure CPU development container (supports linux/amd64 and linux/arm64, e.g. Linux server & Apple M4 Mac).
# Target workloads: qualcomm/aimet (#4138/#4128/#4126), ROCm/mori CPU/SSD UMBP (#1095/#770/#920),
# LMCache CPU unit tests (#6748), sglang-omni async tests (#4629), pytorch/executorch.

ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
ARG APT_MIRROR=""
ARG INSTALL_GH_CLI=true
ARG INSTALL_CPP_EXTRA=true

# Install uv (multi-arch official static binary)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Install common compilers, C++ libraries (io_uring, numa, ibverbs, mpi, gtest), and CLI tools
COPY scripts/install-common.sh /tmp/install-common.sh
RUN chmod +x /tmp/install-common.sh && \
    APT_MIRROR="${APT_MIRROR}" \
    INSTALL_GH_CLI="${INSTALL_GH_CLI}" \
    INSTALL_CPP_EXTRA="${INSTALL_CPP_EXTRA}" \
    USERNAME="${USERNAME}" \
    USER_UID="${USER_UID}" \
    USER_GID="${USER_GID}" \
    /tmp/install-common.sh && \
    rm -f /tmp/install-common.sh

COPY scripts/entrypoint.sh /usr/local/bin/oss-entrypoint.sh
COPY scripts/mkvenv.sh /usr/local/bin/mkvenv
RUN chmod +x /usr/local/bin/oss-entrypoint.sh /usr/local/bin/mkvenv

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    OSS_CONTRIB_PROFILE=cpu \
    UV_CACHE_DIR=/cache/uv \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy \
    PIP_CACHE_DIR=/cache/pip \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch \
    CCACHE_DIR=/cache/ccache \
    TRITON_CACHE_DIR=/cache/triton \
    PATH="/usr/lib/ccache:/usr/local/bin:${PATH}"

WORKDIR /workspace/oss-contrib
USER ${USER_UID}:${USER_GID}

ENTRYPOINT ["/usr/local/bin/oss-entrypoint.sh"]
CMD ["sleep", "infinity"]
